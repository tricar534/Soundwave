# SW-207 - LOCAL / CI-ONLY Soundwave integration test configuration.
# Copy to backend/.env.integration.local, then replace the password placeholder.
# NEVER commit a file containing a real password.
# Use a dedicated, disposable PostgreSQL test database with the SW-132 seed data.

NODE_ENV=test
INTEGRATION_TEST_DB=1

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=soundwaves_dev
DB_PASSWORD=REPLACE_WITH_TEST_ONLY_PASSWORD
DB_NAME=soundwaves_test

# SW-132 uses Supertest against the Express app in process.
# No BACKEND_PORT, API_BASE_URL, or DATABASE_URL is required by these tests.
# Prisma migrations and seeding use DATABASE_URL separately (see docs).
