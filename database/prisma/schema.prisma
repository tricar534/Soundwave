generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(255)
  bio       String?  @db.Text
  imagePath String?  @map("image_path") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trackArtists TrackArtist[]
  albumArtists AlbumArtist[]

  // Preserve existing trigram search index.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_artists_name")
  @@map("artists")
}

model Album {
  id          BigInt    @id @default(autoincrement())
  title       String    @db.VarChar(255)
  releaseDate DateTime? @map("release_date") @db.Date
  artworkId   BigInt?   @map("artwork_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  artwork      Artwork?     @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  tracks       Track[]
  albumArtists AlbumArtist[]


  // Preserve existing trigram search index.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_albums_title")

  @@map("albums")
}

model Track {
  id          BigInt   @id @default(autoincrement())
  albumId     BigInt?  @map("album_id")
  title       String   @db.VarChar(255)
  trackNumber Int?     @map("track_number") @db.SmallInt
  durationMs  Int      @map("duration_ms")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  album        Album?        @relation(fields: [albumId], references: [id], onDelete: SetNull)
  trackArtists TrackArtist[]
  trackGenres  TrackGenre[]
  mediaFiles   MediaFile[]

  // SW-250: Connect existing catalog tracks to user playlists.
  playlistTracks PlaylistTrack[]

  @@index([albumId], map: "idx_tracks_album_id")

  // Preserve existing trigram search index.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_tracks_title")

  @@map("tracks")
}

model Genre {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique(map: "uq_genres_name") @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trackGenres TrackGenre[]

  // Preserve existing trigram search index.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_genres_name")
  @@map("genres")
}

model Artwork {
  id        BigInt   @id @default(autoincrement())
  filePath  String   @unique(map: "uq_artwork_file_path") @map("file_path") @db.VarChar(500)
  fileName  String   @map("file_name") @db.VarChar(255)
  mediaType String   @map("media_type") @db.VarChar(100)
  fileSize  BigInt?  @map("file_size")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  albums Album[]

  @@map("artwork")
}

model MediaFile {
  id        BigInt   @id @default(autoincrement())
  trackId   BigInt   @map("track_id")
  filePath  String   @unique(map: "uq_media_files_file_path") @map("file_path") @db.VarChar(500)
  fileName  String   @map("file_name") @db.VarChar(255)
  mediaType String   @map("media_type") @db.VarChar(100)
  fileSize  BigInt   @map("file_size")
  codec     String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  @@index([trackId], map: "idx_media_files_track_id")
  @@map("media_files")
}

model TrackArtist {
  trackId     BigInt  @map("track_id")
  artistId    BigInt  @map("artist_id")
  artistOrder Int     @default(1) @map("artist_order") @db.SmallInt
  role        String? @db.VarChar(50)

  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Restrict)

  @@id([trackId, artistId])
  @@index([artistId], map: "idx_track_artists_artist_id")
  @@map("track_artists")
}

model AlbumArtist {
  albumId     BigInt  @map("album_id")
  artistId    BigInt  @map("artist_id")
  artistOrder Int     @default(1) @map("artist_order") @db.SmallInt
  isPrimary   Boolean @default(false) @map("is_primary")

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Restrict)

  @@id([albumId, artistId])
  @@index([artistId], map: "idx_album_artists_artist_id")
  @@map("album_artists")
}

model TrackGenre {
  trackId BigInt @map("track_id")
  genreId BigInt @map("genre_id")

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([trackId, genreId])
  @@index([genreId], map: "idx_track_genres_genre_id")
  @@map("track_genres")
}

model Role {
  id          BigInt  @id @default(autoincrement())
  name        String  @unique(map: "uq_roles_name") @db.VarChar(50)
  description String? @db.VarChar(255)

  users User[]

  @@map("roles")
}

model User {
  id           BigInt   @id @default(autoincrement())
  roleId       BigInt   @map("role_id")
  username     String   @unique(map: "uq_users_username") @db.VarChar(50)
  email        String   @unique(map: "uq_users_email") @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  role     Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions Session[]

  // SW-250: Allow users to own multiple playlists.
  playlists Playlist[]

  @@index([roleId], map: "idx_users_role_id")
  @@map("users")
}

model Session {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique(map: "uq_sessions_token_hash") @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}


// SW-250: Store user-created playlists and their ownership.
model Playlist {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistTracks PlaylistTrack[]

  @@index([userId], map: "idx_playlists_user_id")
  @@map("playlists")
}

// SW-250: Associate existing music tracks with saved playlists.
model PlaylistTrack {
  playlistId BigInt   @map("playlist_id")
  trackId    BigInt   @map("track_id")
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@index([trackId], map: "idx_playlist_tracks_track_id")
  @@map("playlist_tracks")
}

